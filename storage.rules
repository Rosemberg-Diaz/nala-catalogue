rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{imageId} {
      // Images are public catalogue assets. Knowing a URL may reveal an inactive product's image.
      allow read: if true;
      allow create: if request.auth != null && request.auth.token.admin == true
        && imageId.matches('[a-zA-Z0-9-]+[.]webp')
        && request.resource.size > 0 && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType == 'image/webp';
      allow update, delete: if false;
    }
    match /{path=**} { allow read, write: if false; }
  }
}
