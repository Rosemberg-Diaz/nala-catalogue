# mock funciona sin cuentas ni credenciales. firebase exige todos sus valores.
VITE_DATA_SOURCE=mock
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# static conserva el plan Spark. firebase-storage requiere Blaze (opcional).
VITE_IMAGE_PROVIDER=static
# Número del negocio confirmado; Colombia (+57), solo dígitos.
VITE_WHATSAPP_NUMBER=573173560428
VITE_PICKUP_ADDRESS=
VITE_SITE_URL=
VITE_FIREBASE_EMULATORS=false
