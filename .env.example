# mock funciona sin cuentas ni credenciales. firebase exige todos sus valores.
VITE_DATA_SOURCE=mock
# Pon firebase para que GitHub Pages también use la base de datos.
VITE_PAGES_DATA_SOURCE=mock
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# firebase-storage permite subir fotos desde el panel; requiere Blaze.
VITE_IMAGE_PROVIDER=static
# Para subir fotos desde Nala con Firebase Spark, usa cloudinary (cuenta Free).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
# Número del negocio confirmado; Colombia (+57), solo dígitos.
VITE_WHATSAPP_NUMBER=573150026236
VITE_PICKUP_ADDRESS=
VITE_SITE_URL=
VITE_FIREBASE_EMULATORS=false
