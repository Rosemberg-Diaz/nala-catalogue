{
  "name": "nala-catalogue",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && node scripts/build-pages.mjs",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-nala \"vitest run --config vitest.rules.config.ts\"",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "deploy": "node scripts/check-deploy.mjs && npm run check && firebase deploy --only hosting,firestore",
    "admin:grant": "node scripts/grant-admin.mjs"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "firebase-admin": "^13.4.0",
    "firebase-tools": "^14.12.0",
    "globals": "^16.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
